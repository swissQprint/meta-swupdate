From 73790a6e9e4761f93529311c7a97ebca9e5a028d Mon Sep 17 00:00:00 2001
From: Andreas Kalberer <aka@swissqprint.com>
Date: Tue, 14 Mar 2023 07:35:14 +0100
Subject: [PATCH] Feature: Add HTTP Put request to swupdate-progress to update
 progress via HTTP.

---
 tools/swupdate-progress.c | 66 ++++++++++++++++++++++++++++++++++++++-
 1 file changed, 65 insertions(+), 1 deletion(-)

diff --git a/tools/swupdate-progress.c b/tools/swupdate-progress.c
index e3f010b..9763a76 100644
--- a/tools/swupdate-progress.c
+++ b/tools/swupdate-progress.c
@@ -23,6 +23,8 @@
 #include <pthread.h>
 #include <getopt.h>
 
+#include <curl/curl.h>
+
 #include <progress_ipc.h>
 
 #define PSPLASH_MSG_SIZE	64
@@ -206,13 +208,19 @@ int main(int argc, char **argv)
 	int opt_w = 0;
 	int opt_r = 0;
 	int opt_p = 0;
+	int opt_u = 0;
 	int c;
 	int ret;
 	char *script = NULL;
 	bool wait_update = true;
 
+	CURL *curl;
+	CURLcode res;
+	char put_buffer[1024];
+	struct curl_slist *put_headers = NULL;
+
 	/* Process options with getopt */
-	while ((c = getopt_long(argc, argv, "cwprhs:e:",
+	while ((c = getopt_long(argc, argv, "cwprhus:e:",
 				long_options, NULL)) != EOF) {
 		switch (c) {
 		case 'c':
@@ -240,6 +248,9 @@ int main(int argc, char **argv)
 		case 'q':
 			silent = true;
 			break;
+		case 'u':
+			opt_u = 1;
+			break;
 		default:
 			usage(argv[0]);
 			exit(1);
@@ -252,6 +263,38 @@ int main(int argc, char **argv)
 		rundir = "/run";
 	snprintf(psplash_pipe_path, sizeof(psplash_pipe_path), "%s/psplash_fifo", rundir);
 
+	if(opt_u) {
+		// init for HTTP PUT progress updates
+		curl_global_init(CURL_GLOBAL_ALL);
+ 
+		/* get a curl handle */
+		curl = curl_easy_init();
+		if(curl) {
+			// prepare header for PUT
+			put_headers = curl_slist_append(put_headers, "Content-Type: application/text");
+			if(put_headers == NULL) {
+				exit(1);
+			}
+			struct curl_slist *temp = curl_slist_append(put_headers, "charsets: utf-8");
+			if(temp == NULL) {
+				exit(1);
+			}
+			put_headers = temp;
+    		res = curl_easy_setopt(curl, CURLOPT_HTTPHEADER, put_headers);
+			if(res != CURLE_OK)
+				fprintf(stderr, "curl_easy_setopt() CURLOPT_HTTPHEADER failed: %s\n",
+						curl_easy_strerror(res));
+			res = curl_easy_setopt(curl, CURLOPT_CUSTOMREQUEST, "PUT");
+			if(res != CURLE_OK)
+				fprintf(stderr, "curl_easy_setopt() CURLOPT_CUSTOMREQUEST failed: %s\n",
+						curl_easy_strerror(res));
+			res = curl_easy_setopt(curl, CURLOPT_URL, "http://172.16.1.1:8280/progress");
+			if(res != CURLE_OK)
+				fprintf(stderr, "curl_easy_setopt() CURLOPT_URL failed: %s\n",
+						curl_easy_strerror(res));
+		}
+	}
+
 	connfd = -1;
 	while (1) {
 		if (connfd < 0) {
@@ -340,6 +383,21 @@ int main(int argc, char **argv)
 					curstep = msg.cur_step;
 					percent = msg.cur_percent;
 				}
+				if (opt_u) {
+					int len = snprintf(put_buffer, 1024,
+						"#12,number: %d,step: %d,name: %s,percent: %d",
+						msg.nsteps,
+						msg.cur_step,
+						msg.cur_step ? msg.cur_image : "",
+						msg.cur_percent);
+					curl_easy_setopt(curl, CURLOPT_POSTFIELDS, put_buffer);
+					res = curl_easy_perform(curl);
+					/* Check for errors */
+					if(res != CURLE_OK)
+					fprintf(stderr, "curl_easy_perform() failed: %s\n",
+							curl_easy_strerror(res));
+				}
+
 				curstep = msg.cur_step;
 				percent = msg.cur_percent;
 			}
@@ -391,4 +449,10 @@ int main(int argc, char **argv)
 			break;
 		}
 	}
+
+	if(opt_u) {
+		/* always cleanup */
+		curl_easy_cleanup(curl);
+		curl_global_cleanup();
+	}
 }
-- 
2.34.1

